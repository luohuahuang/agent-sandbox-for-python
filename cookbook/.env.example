# agent-sandbox cookbook — copy to .env and fill in values.

# ── Sandbox ──────────────────────────────────────────────────────────────────
SANDBOX_API_KEY=change-me-please
SANDBOX_BASE_URL=http://localhost:8080

# ── LLM ──────────────────────────────────────────────────────────────────────
# Provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# API key for the chosen provider.
LLM_API_KEY=

# Model override (optional — defaults to claude-haiku-4-5-20251001 / gpt-4o-mini).
# LLM_MODEL=claude-haiku-4-5-20251001

# ── Demo paths (optional) ────────────────────────────────────────────────────
# DEMO_CONV_ID=cookbook-llm-pipeline
# DEMO_LOCAL_CSV=assets/orders.csv
# DEMO_REMOTE_CSV=/workspace/orders.csv
# DEMO_ARTIFACTS_DIR=artifacts
# DEMO_EXEC_TIMEOUT=60
# LLM_TIMEOUT=60
