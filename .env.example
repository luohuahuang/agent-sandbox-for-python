# agent-sandbox configuration. Copy to .env and tune.

# Gateway auth
SANDBOX_API_KEY=change-me-please

# Sandbox image (built from docker/Dockerfile.sandbox)
SANDBOX_IMAGE=agent-sandbox:latest

# Template → image mapping (JSON). "default" is used when no template is
# specified. Built-in templates (all built by deploy_linux.sh auto-scan):
#   default             — Python + data science libs (Dockerfile.sandbox)
#   web-automation      — Playwright + Chromium (Dockerfile.sandbox.web-automation)
#   android-automation  — ADB client + uiautomator2; connects to host ADB server
#                         via host.docker.internal:5037 (Dockerfile.sandbox.android-automation)
# SANDBOX_TEMPLATES={"default":"agent-sandbox:latest","web-automation":"agent-sandbox:web-automation","android-automation":"agent-sandbox:android-automation"}

# Workspace root on the host. One subdir per session. The default
# (~/.agent-sandbox/ws) lives under $HOME so Colima's Lima VM, which
# only bind-mounts /Users by default, can see the workspace. If you
# move this elsewhere on macOS+Colima, start colima with an extra
# writable mount, e.g.:
#     colima start --mount /var/lib/agent-sandbox:w
# WORKSPACE_ROOT=/Users/<you>/.agent-sandbox/ws

# Audit DB (Phase 3). SQLite at this path; auto-created on startup.
# Each /exec call writes one row; sessions table records create/destroy
# events. Read via GET /v1/audit/{audit_id} and GET /v1/audit/sessions/{id}/execs.
AUDIT_DB_PATH=./data/sandbox_audit.db

# Resource defaults (per container)
MEM_LIMIT_MB=1024
CPU_NANOS=2000000000
PIDS_LIMIT=256

# Lifecycle
EXEC_TIMEOUT_S=60
KILL_GRACE_S=5
IDLE_TTL_S=1800
MAX_AGE_S=28800
MAX_SESSIONS=32

# Egress proxy (Phase 2). Comma-separated hostnames; bare names match
# the domain and all subdomains. "*.foo.com" is accepted and normalized.
EGRESS_ALLOWLIST=pypi.org,files.pythonhosted.org,*.pythonhosted.org
# Stock public squid image. Pre-pull with `docker pull ubuntu/squid:latest`.
PROXY_IMAGE=ubuntu/squid:latest
PROXY_CONTAINER_NAME=sbx-proxy
NETWORK_NAME=sbx-net
