FROM python:3.11-slim

# Optional PyPI mirror for build-time pip install.
ARG PIP_INDEX_URL=""
ARG PIP_TRUSTED_HOST=""

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    # ADB client and Appium server run on the HOST; this container connects
    # via host.docker.internal (injected by docker_runtime.py).
    ANDROID_ADB_SERVER_ADDRESS=host.docker.internal \
    ANDROID_ADB_SERVER_PORT=5037 \
    APPIUM_HOST=host.docker.internal \
    APPIUM_PORT=4723

RUN useradd -u 1000 -m sbx

# ── System deps ──────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        # Playwright/Chromium runtime deps
        libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
        libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
        libgbm1 libasound2 libpango-1.0-0 libcairo2 libx11-6 libx11-xcb1 \
        libxcb1 libxext6 libxcursor1 libxi6 libxtst6 \
        ca-certificates fonts-liberation \
        # ADB client for Android/iOS automation via host ADB server
        adb \
    && rm -rf /var/lib/apt/lists/*

# ── Python packages ──────────────────────────────────────────────────────────
RUN pip install --no-cache-dir \
    \
    # ── Jupyter kernel (required by sandbox gateway) ──
    ipykernel==6.29.5 \
    jupyter_client==8.6.2 \
    \
    # ── Core data / utility ──
    numpy \
    pandas \
    matplotlib \
    requests \
    httpx \
    \
    # ── Web automation ──
    playwright \
    pytest-playwright \
    respx \
    \
    # ── App automation (Android + iOS) ──
    Appium-Python-Client \
    uiautomator2 \
    pure-python-adb \
    \
    # ── Test framework ──
    pytest \
    pytest-asyncio \
    pytest-html \
    pytest-xdist \
    allure-pytest \
    \
    # ── Test data & assertions ──
    faker \
    pydantic \
    deepdiff \
    jsonschema

# ── Playwright: install Chromium only ────────────────────────────────────────
RUN playwright install chromium

RUN mkdir -p /opt/pw-browsers && chown -R 1000:1000 /opt/pw-browsers

# ── Workspace ────────────────────────────────────────────────────────────────
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && \
    mkdir -p /workspace && chown 1000:1000 /workspace

USER sbx
WORKDIR /workspace

EXPOSE 5555 5556 5557 5558 5559

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
