FROM python:3.11-slim

# Optional PyPI mirror for build-time pip install.
ARG PIP_INDEX_URL=""
ARG PIP_TRUSTED_HOST=""

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    # Both ADB server and Appium server run on the HOST, not in this container.
    # host.docker.internal resolves to the host gateway via extra_hosts
    # injected by docker_runtime.py (Docker 20.10+).
    ANDROID_ADB_SERVER_ADDRESS=host.docker.internal \
    ANDROID_ADB_SERVER_PORT=5037 \
    APPIUM_HOST=host.docker.internal \
    APPIUM_PORT=4723

RUN useradd -u 1000 -m sbx

# ── System deps ──────────────────────────────────────────────────────────────
# adb client only — no server, no USB daemon needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
        adb \
    && rm -rf /var/lib/apt/lists/*

# ── Python packages ──────────────────────────────────────────────────────────
RUN pip install --no-cache-dir \
    \
    # ── Jupyter kernel (required by sandbox gateway) ──
    ipykernel==6.29.5 \
    jupyter_client==8.6.2 \
    \
    # ── Core data / utility ──
    numpy \
    pandas \
    requests \
    httpx \
    \
    # ── Android automation ──
    # Appium-Python-Client: WebDriver-based client that talks to Appium server
    # on the host over HTTP (host.docker.internal:4723). Appium server itself
    # is a Node.js process that must run on the host alongside adb server.
    Appium-Python-Client \
    # uiautomator2: lighter-weight UI automation via adb + on-device agent;
    # useful when full Appium setup is not available.
    uiautomator2 \
    # pure-python-adb: direct adb-server TCP protocol for low-level shell/file ops
    pure-python-adb \
    \
    # ── Test framework ──
    pytest \
    pytest-asyncio \
    pytest-html \
    pytest-xdist \
    allure-pytest \
    \
    # ── Test data & assertions ──
    faker \
    pydantic \
    deepdiff \
    jsonschema

# ── Workspace ────────────────────────────────────────────────────────────────
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && \
    mkdir -p /workspace && chown 1000:1000 /workspace

USER sbx
WORKDIR /workspace

EXPOSE 5555 5556 5557 5558 5559

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
