FROM python:3.11-slim

# Optional PyPI mirror for build-time pip install.
ARG PIP_INDEX_URL=""
ARG PIP_TRUSTED_HOST=""

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    # Appium server and ADB server both run on the HOST, not in this container.
    # This image supports both Android and iOS app UI automation:
    #   Android: adb client → host ADB server (5037) → USB/WiFi device
    #   iOS:     Appium-Python-Client → host Appium server (4723) → WebDriverAgent on device
    # host.docker.internal resolves to the host gateway via extra_hosts
    # injected by docker_runtime.py (Docker 20.10+).
    ANDROID_ADB_SERVER_ADDRESS=host.docker.internal \
    ANDROID_ADB_SERVER_PORT=5037 \
    APPIUM_HOST=host.docker.internal \
    APPIUM_PORT=4723

RUN useradd -u 1000 -m sbx

# ── System deps ──────────────────────────────────────────────────────────────
# adb client only — no server, no USB daemon needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
        adb \
    && rm -rf /var/lib/apt/lists/*

# ── Python packages ──────────────────────────────────────────────────────────
RUN pip install --no-cache-dir \
    \
    # ── Jupyter kernel (required by sandbox gateway) ──
    ipykernel==6.29.5 \
    jupyter_client==8.6.2 \
    \
    # ── Core data / utility ──
    numpy \
    pandas \
    requests \
    httpx \
    \
    # ── App automation (Android + iOS) ──
    # Appium-Python-Client: WebDriver-based client connecting to host Appium server
    # (host.docker.internal:4723); supports Android and iOS via the same API.
    Appium-Python-Client \
    # uiautomator2: Android-only lighter-weight alternative via adb + on-device agent;
    # useful when full Appium stack is not available.
    uiautomator2 \
    # pure-python-adb: Android low-level adb-server TCP protocol (shell, file push/pull)
    pure-python-adb \
    \
    # ── Test framework ──
    pytest \
    pytest-asyncio \
    pytest-html \
    pytest-xdist \
    allure-pytest \
    \
    # ── Test data & assertions ──
    faker \
    pydantic \
    deepdiff \
    jsonschema

# ── Workspace ────────────────────────────────────────────────────────────────
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && \
    mkdir -p /workspace && chown 1000:1000 /workspace

USER sbx
WORKDIR /workspace

EXPOSE 5555 5556 5557 5558 5559

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
